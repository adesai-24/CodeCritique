# Python Caches
__pycache__/
*.py[cod]
*$py.class
.ipynb_checkpoints

# Tool Caches
.mypy_cache/
.ruff_cache/
.pytest_cache/
.tmp/
.coverage
htmlcov/
.claude
.worktrees
.vscode
.codecritique/

# Secrets — never commit API keys
secrets.env
*.secrets
.env

# Environment
.venv/
env/
venv/
ENV/

# Build/Distribution
dist/
build/
*.egg-info/

# Vendored CodeCritique — prefer `pip install git+...` over committing a clone.
# These keep an accidental nested clone out of a project repo so the tool stays
# invisible. Copy this block into your own project's .gitignore if you vendor it.
/CodeCritique/
/codecritique/
.codecritique-tool/
